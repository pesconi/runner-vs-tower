  profiles:
  - id: legacy-toon
    legacy: 1
    shaders:
    - StudioKit/ToonLit
    note: 'Toon lit, 3-band ramp: structures, crowd, obstacles, props.'
  - id: legacy-translucent
    legacy: 1
    shaders:
    - Universal Render Pipeline/Unlit
    note: 'URP Unlit, transparent: gate panels, shadows, danger strip, dome.'
  - id: legacy-text
    legacy: 1
    shaders:
    - TextMeshPro/
    note: 'TextMeshPro distance field: menu, HUD, gate and floating numbers.'
  - id: legacy-ui-text
    legacy: 1
    shaders:
    - GUI/Text Shader
    note: 'The built-in text shader of the dynamic font (UI.Text and TextMesh: health labels, a few HUD texts).'
  - id: legacy-sky
    legacy: 1
    shaders:
    - StudioKit/SkyGradientScreen
    note: The sky gradient (reads the palette globals).
  - id: legacy-track
    legacy: 1
    shaders:
    - StudioKit/StripedTrack
    note: The striped track.
  - id: legacy-blob-shadow
    legacy: 1
    shaders:
    - StudioKit/BlobShadowInstanced
    note: The instanced blob shadow of the crowd.
  - id: vinyl
    legacy: 0
    shaders: []
    note: 'v3: the character (edge light, soft specular, warm shade). Shader: K.v3a.'
  - id: matte-plastic
    legacy: 0
    shaders: []
    note: 'v3: scenery, floor, towers. Shader: K.v3a.'
  - id: gate-glow
    legacy: 0
    shaders: []
    note: 'v3: translucent gate with a lit edge, no depth write. Shader: K.v3a.'
  - id: enemy
    legacy: 0
    shaders: []
    note: 'v3: darkened vinyl with a threat-colored edge. Shader: K.v3a.'
  - id: ui-effect
    legacy: 0
    shaders: []
    note: 'v3: unlit UI and effects. Shader: K.v3a.'
