  effects:
  - effect: 0
    maxActive: 12
    note: numbers that float up from a gate (FloatingNumbers pool)
  - effect: 1
    maxActive: 1
    note: the army counter pop in the HUD
  - effect: 2
    maxActive: 512
    note: ballistic deaths of the instanced swarms (assault); the obstacles' ring is smaller
  - effect: 3
    maxActive: 1
    note: the run camera's shake on a bad gate
  - effect: 4
    maxActive: 32
    note: stone and landing shadow of the cannon (pool)
  - effect: 5
    maxActive: 4
    note: tower floors crumbling (blocks per body)
  sounds:
  - clip: Coin
    playedBy: 'role Coin: purchase (short double bell)'
    peakDb: -1
    peakToleranceDb: 1.5
    loudnessDb: -15
    loudnessToleranceDb: 5
    minSeconds: 0.05
    maxSeconds: 1.5
  - clip: GateGood
    playedBy: 'role GateGood: crowd takes a good gate (ratchet + first three notes of the motif on a short bell)'
    peakDb: -1
    peakToleranceDb: 1.5
    loudnessDb: -15
    loudnessToleranceDb: 5
    minSeconds: 0.05
    maxSeconds: 1.5
  - clip: GateBad
    playedBy: 'role GateBad: bad gate or obstacle loss (coil spring loosening)'
    peakDb: -1
    peakToleranceDb: 1.5
    loudnessDb: -15
    loudnessToleranceDb: 5
    minSeconds: 0.05
    maxSeconds: 1.5
  - clip: UnitLoss
    playedBy: 'role UnitLoss: a figure bursts into pieces and confetti (assault)'
    peakDb: -1
    peakToleranceDb: 1.5
    loudnessDb: -15
    loudnessToleranceDb: 5
    minSeconds: 0.05
    maxSeconds: 1.5
  - clip: Finish
    playedBy: role Finish
    peakDb: -1
    peakToleranceDb: 1.5
    loudnessDb: -15
    loudnessToleranceDb: 5
    minSeconds: 0.05
    maxSeconds: 1.5
  - clip: Victory
    playedBy: role Victory
    peakDb: -1
    peakToleranceDb: 1.5
    loudnessDb: -15
    loudnessToleranceDb: 5
    minSeconds: 0.5
    maxSeconds: 3
  - clip: Defeat
    playedBy: role Defeat
    peakDb: -1
